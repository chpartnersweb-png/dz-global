---
import SiteHeader from '../components/SiteHeader.astro';
import HeroStory from '../components/HeroStory.astro';
import StrengthsSection from '../components/StrengthsSection.astro';
import BusinessSection from '../components/BusinessSection.astro';
import ApproachSection from '../components/ApproachSection.astro';
import CompanySection from '../components/CompanySection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { company } from '../data/company';
import '@fontsource-variable/noto-sans-jp';
import '../styles/global.scss';
import '../styles/home.scss';

const title = `${company.name} | 日本と海外の企業をつなぐ橋渡し`;
const description = '海外企業と日本企業の橋渡しをするD&Z Global 株式会社。多国籍な人材と各分野の専門家の経験を生かし、組織・人事、店舗・施設の運営支援、国際貿易、旅行事業などを展開しています。';
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  telephone: '+81-3-6698-1273',
  address: {
    '@type': 'PostalAddress', postalCode: company.postalCode,
    addressRegion: '東京都', addressLocality: '港区',
    streetAddress: '北青山一丁目3番1号 アールキューブ青山3階', addressCountry: 'JP',
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (window.location.hash && !['#', '#top'].includes(window.location.hash)) return;
        const root = document.documentElement;
        root.classList.add('page-entering');
        // If the animation bundle fails, release the content automatically.
        window.setTimeout(() => root.classList.remove('page-entering'), 3200);
        window.addEventListener('pageshow', (event) => {
          if (event.persisted) root.classList.remove('page-entering');
        });
      })();
    </script>
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        html.page-entering [data-header],
        html.page-entering [data-hero-visual],
        html.page-entering [data-hero-line],
        html.page-entering [data-hero-detail],
        html.page-entering [data-hero-tiles] { visibility: hidden; }
      }
    </style>
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動する</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <HeroStory />
      <StrengthsSection />
      <BusinessSection />
      <ApproachSection />
      <CompanySection />
      <ContactSection />
    </main>
    <SiteFooter />
    <script>
      import { initMotion } from '../scripts/motion';
      const cleanup = initMotion();
      if (import.meta.hot) import.meta.hot.dispose(cleanup);
    </script>
  </body>
</html>
