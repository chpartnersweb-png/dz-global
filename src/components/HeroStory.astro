---
import CorporateHero from './CorporateHero.astro';
import AboutSection from './AboutSection.astro';

const panels = [
  [6, 15, 5, .18, 1.3], [28, 9, 3, .12, .8], [47, 19, 7, .2, 1.4],
  [77, 12, 4, .3, .75], [91, 28, 9, .25, 1.3], [64, 35, 4, .16, 1],
  [86, 56, 5, .38, .8], [53, 68, 3, .2, 1.4], [73, 79, 10, .3, 1.4],
  [26, 87, 5, .16, .75], [9, 70, 3, .12, 1], [96, 88, 4, .24, 1],
];
---

<div class="hero-story" data-hero-story>
  <div class="hero-story__visual" aria-hidden="true">
    <div class="hero-story__viewport" data-hero-tiles>
      <div class="hero-story__fallback">
        {panels.map(([x, y, size, alpha, ratio]) => (
          <span style={`left:${x}%;top:${y}%;width:clamp(22px,${size}vw,130px);opacity:${alpha};aspect-ratio:${ratio}`}></span>
        ))}
      </div>
    </div>
  </div>
  <CorporateHero />
  <AboutSection />
</div>
